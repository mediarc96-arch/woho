generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(TRAVELER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostedTours           Tour[]         @relation("HostTours")
  bookings              Booking[]      @relation("TravelerBookings")
  hostConversations     Conversation[] @relation("HostConversations")
  travelerConversations Conversation[] @relation("TravelerConversations")
  sentMessages          Message[]      @relation("SentMessages")
  authoredReviews       Review[]       @relation("AuthoredReviews")

  @@map("users")
}

enum UserRole {
  TRAVELER
  HOST
}

model Tour {
  id               String            @id @default(uuid())
  hostId           String
  title            String
  description      String
  category         TourCategory
  city             String
  priceAmount      Int
  priceCurrency    String            @default("EUR")
  durationMinutes  Int
  meetingPoint     String
  afterTourOptions AfterTourOption[]
  status           TourStatus        @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  host          User           @relation("HostTours", fields: [hostId], references: [id])
  bookings      Booking[]
  conversations Conversation[]
  reviews       Review[]

  @@index([city])
  @@index([hostId])
  @@map("tours")
}

enum TourCategory {
  FOOD
  CULTURE
  NIGHTLIFE
  NATURE
  SHOPPING
  HISTORY
}

enum AfterTourOption {
  MEAL
  DRINKS
  CAFE
}

enum TourStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Booking {
  id            String        @id @default(uuid())
  tourId        String
  travelerId    String
  scheduledAt   DateTime
  headcount     Int
  priceAmount   Int
  priceCurrency String        @default("EUR")
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tour     Tour    @relation(fields: [tourId], references: [id])
  traveler User    @relation("TravelerBookings", fields: [travelerId], references: [id])
  review   Review?

  @@index([travelerId])
  @@index([tourId])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Conversation {
  id            String    @id @default(uuid())
  tourId        String
  hostId        String
  travelerId    String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tour     Tour      @relation(fields: [tourId], references: [id])
  host     User      @relation("HostConversations", fields: [hostId], references: [id])
  traveler User      @relation("TravelerConversations", fields: [travelerId], references: [id])
  messages Message[]

  @@unique([tourId, travelerId])
  @@index([hostId])
  @@index([travelerId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  tourId    String
  authorId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  tour    Tour    @relation(fields: [tourId], references: [id])
  author  User    @relation("AuthoredReviews", fields: [authorId], references: [id])

  @@index([tourId])
  @@index([authorId])
  @@map("reviews")
}
